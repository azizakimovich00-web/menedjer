BOT_TOKEN=your_telegram_bot_token
# Comma-separated Telegram IDs who should become directors on first start.
DIRECTOR_IDS=123456789,987654321
PIN_REQUIRED_ON_START=true

# Local PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/menedjer
# On Railway this variable is injected automatically by the PostgreSQL service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/menedjer

# Optional production tuning.
EXPORTS_DIR=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_CONNECT_RETRIES=10
